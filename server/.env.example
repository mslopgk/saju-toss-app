# 견본. 이 파일을 그대로 복사해 값을 채우되 **`.env` 는 커밋하지 않는다**(.gitignore 에 있다).
# 서버는 .env 파일을 읽지 않는다 — 프로세스 매니저나 컨테이너의 환경변수 주입을 쓴다.
#   systemd: EnvironmentFile=/etc/sajumix/interpret.env  (chmod 600)
#   docker : --env-file 또는 시크릿 마운트
#   로컬   : ANTHROPIC_API_KEY=... npm start

# 필수. 없으면 기동하지 않는다.
ANTHROPIC_API_KEY=

# 리스닝
PORT=8787
HOST=127.0.0.1

# CORS — 비우면 토스 미니앱 두 오리진이 기본값이다.
# CORS_ORIGINS=https://sajuapp.web.tossmini.com,https://sajuapp.private-web.tossmini.com

# 리버스 프록시 뒤에 있을 때만 켠다. 프록시가 없는데 켜면 레이트리밋이 무력화된다.
TRUST_PROXY=false

# 비용 방어
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
MAX_IN_FLIGHT=4
CACHE_MAX_ENTRIES=2000
CACHE_TTL_MS=86400000
# 2 로 올리면 검증 실패 시 재시도한다 = 원가 최대 2배.
INTERPRET_MAX_ATTEMPTS=1

# 업스트림
UPSTREAM_TIMEOUT_MS=120000
UPSTREAM_MAX_RETRIES=2
# 베타가 조직에 열려 있지 않아 400 이 나면 런타임이 자동으로 끄고 재시도한다.
ANTHROPIC_SERVER_SIDE_FALLBACK=true

MAX_BODY_BYTES=131072
LOG_LEVEL=info
