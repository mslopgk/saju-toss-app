{
  "name": "sajumix-interpret-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "사주믹스 LLM 해석 서버. 프롬프트·지식카드·API 키는 여기에만 있다.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "esbuild src/main.ts scripts/smoke.ts scripts/model-ab.ts scripts/split-smoke.ts --bundle --platform=node --target=node20 --format=esm --charset=utf8 --packages=external --outdir=dist --out-extension:.js=.mjs --entry-names=[name]",
    "start": "node dist/main.mjs",
    "dev": "npm run build && npm run start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node dist/smoke.mjs",
    "model-ab": "node dist/model-ab.mjs",
    "split-smoke": "node dist/split-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
